# Files staged for manual deletion (sandbox cannot rm; remove from your shell)
_todelete/

# One-off timestamped backup files (use git history instead)
scorer.backup.*.html
*.backup.*.html

# Recovery artefacts from Claude Code restore operations
*.restored

# Brand-film UI capture output (regenerable, large PNG/MP4)
capture-out/

# Graphify generated output (knowledge graph cache, analysis, reports)
graphify-out/

# Claude Code local settings (machine-specific paths, session IDs)
.claude/settings.local.json
